[Unit]
Description=home-ops seo-analyse — morning SEO analysis card (+ headless Claude narrative)
After=docker.service network-online.target seo-collect.service
Wants=network-online.target
OnFailure=unit-failure-mail@%n.service
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/code/logs-stack
EnvironmentFile=%h/code/logs-stack/ops/elitedesk/seo-collect.env
ExecStartPre=/usr/bin/bash %h/code/logs-stack/ops/elitedesk/wait-for-postgres.sh
ExecStart=/usr/bin/python3 %h/code/logs-stack/ops/elitedesk/seo-analyse.py
# Transient failures (network, ingest still starting): retry every 10 min, max 3 starts in 2 h.
Restart=on-failure
RestartSec=10min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
