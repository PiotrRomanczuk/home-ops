<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_mac_worker" targetNamespace="https://github.com/PiotrRomanczuk/home-ops" exporter="home-ops gen.py" exporterVersion="2026-11-15">
  <bpmn:documentation>Mac worker (home-ops PR #83), 2026-11-15: agenci Claude w oknach i w 80% limitu, lokalne LLM, nadzorca GPU, pomysły z notatki i WhatsAppa.</bpmn:documentation>
  <bpmn:collaboration id="Collaboration_mac_worker">
    <bpmn:participant id="Pool_Piotr" name="Piotr" processRef="Process_Piotr" />
    <bpmn:participant id="Pool_OpenClaw" name="OpenClaw (WhatsApp)" processRef="Process_OpenClaw" />
    <bpmn:participant id="Pool_Runner" name="Runner: agenci Claude (pl.pionat.home-ops.sprint)" processRef="Process_Runner" />
    <bpmn:participant id="Pool_GPU" name="Nadzorca GPU (pl.pionat.mac-worker.gpu)" processRef="Process_GPU" />
    <bpmn:messageFlow id="Msg_p_idea_o_start" name="WhatsApp" sourceRef="p_idea" targetRef="o_start" />
    <bpmn:messageFlow id="Msg_o_idea_pl_ideas" name="linia w notatce mac-praca-w-tle" sourceRef="o_idea" targetRef="pl_ideas" />
    <bpmn:messageFlow id="Msg_w_save_p_pr" name="PR + „Czeka na Piotra”" sourceRef="w_save" targetRef="p_pr" />
    <bpmn:messageFlow id="Msg_p_gpu_g_collect" name="gpu-jobs.json (root, sudo)" sourceRef="p_gpu" targetRef="g_collect" />
    <bpmn:messageFlow id="Msg_w_borrow_g_read" name="plik gpu/borrow" sourceRef="w_borrow" targetRef="g_read" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_ds_queue" name="queue/" />
  <bpmn:dataStore id="DataStore_ds_usage" name="usage.json" />
  <bpmn:dataStore id="DataStore_ds_note" name="mac-praca-w-tle.md" />
  <bpmn:dataStore id="DataStore_ds_jobs" name="gpu-jobs.json" />
  <bpmn:process id="Process_Piotr" isExecutable="false">
    <bpmn:startEvent id="p_start_eve" name="Wieczorem, kiedy chcesz">
      <bpmn:outgoing>Flow_p_start_eve_p_status</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_p_start_eve">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="p_status" name="Zajrzyj na :8787 i do „Czeka na Piotra”">
      <bpmn:incoming>Flow_p_start_eve_p_status</bpmn:incoming>
      <bpmn:outgoing>Flow_p_status_p_pr</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_pr" name="PR-y na „Dziś”: przejrzyj, scal albo odrzuć">
      <bpmn:incoming>Flow_p_status_p_pr</bpmn:incoming>
      <bpmn:outgoing>Flow_p_pr_p_gpu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_gpu" name="Propozycja GPU: sesja szykuje listę, Ty: sudo install-gpu.sh">
      <bpmn:incoming>Flow_p_pr_p_gpu</bpmn:incoming>
      <bpmn:outgoing>Flow_p_gpu_p_end_eve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p_end_eve" name="Gotowe">
      <bpmn:incoming>Flow_p_gpu_p_end_eve</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="p_start_idea" name="Wpada pomysł">
      <bpmn:outgoing>Flow_p_start_idea_p_idea</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p_idea" name="Dopisz pomysł: notatka albo WhatsApp „mac: …”">
      <bpmn:incoming>Flow_p_start_idea_p_idea</bpmn:incoming>
      <bpmn:outgoing>Flow_p_idea_p_end_idea</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p_end_idea" name="Pomysł zapisany">
      <bpmn:incoming>Flow_p_idea_p_end_idea</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p_start_eve_p_status" sourceRef="p_start_eve" targetRef="p_status" />
    <bpmn:sequenceFlow id="Flow_p_status_p_pr" sourceRef="p_status" targetRef="p_pr" />
    <bpmn:sequenceFlow id="Flow_p_pr_p_gpu" sourceRef="p_pr" targetRef="p_gpu" />
    <bpmn:sequenceFlow id="Flow_p_gpu_p_end_eve" sourceRef="p_gpu" targetRef="p_end_eve" />
    <bpmn:sequenceFlow id="Flow_p_start_idea_p_idea" sourceRef="p_start_idea" targetRef="p_idea" />
    <bpmn:sequenceFlow id="Flow_p_idea_p_end_idea" sourceRef="p_idea" targetRef="p_end_idea" />
  </bpmn:process>
  <bpmn:process id="Process_OpenClaw" isExecutable="false">
    <bpmn:startEvent id="o_start" name="Wiadomość „mac: …”">
      <bpmn:outgoing>Flow_o_start_o_idea</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_o_start" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="o_idea" name="idea.py: jedna linia na końcu sekcji Pomysły">
      <bpmn:incoming>Flow_o_start_o_idea</bpmn:incoming>
      <bpmn:outgoing>Flow_o_idea_o_end</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="o_end" name="Odpowiedź „Dopisane: …”">
      <bpmn:incoming>Flow_o_idea_o_end</bpmn:incoming>
      <bpmn:messageEventDefinition id="MsgDef_o_end" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_o_start_o_idea" sourceRef="o_start" targetRef="o_idea" />
    <bpmn:sequenceFlow id="Flow_o_idea_o_end" sourceRef="o_idea" targetRef="o_end" />
  </bpmn:process>
  <bpmn:process id="Process_Runner" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Runner">
      <bpmn:lane id="Lane_hk" name="Housekeeping (co 60 s)">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_plan" name="Planista (zadanie Opus z kolejki)">
        <bpmn:flowNodeRef>pl_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_ideas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_gpu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pl_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_work" name="Workery (3 naraz)">
        <bpmn:flowNodeRef>w_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_win</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_claude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_away</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_borrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_local</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_wait2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_limitq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_usage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_exh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_pause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>w_rend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Co 60 s">
      <bpmn:outgoing>Flow_h_start_h_split</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_h_start">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT60S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="h_split">
      <bpmn:incoming>Flow_h_start_h_split</bpmn:incoming>
      <bpmn:outgoing>Flow_h_split_h_g1</bpmn:outgoing>
      <bpmn:outgoing>Flow_h_split_h_g2</bpmn:outgoing>
      <bpmn:outgoing>Flow_h_split_h_g3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="h_g1" name="W oknie i ≥ 5 min od odczytu?">
      <bpmn:incoming>Flow_h_split_h_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_h_g1_h_t1</bpmn:outgoing>
      <bpmn:outgoing>Flow_h_g1_h_e1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="h_t1" name="Odczyt /usage → usage.json (0 tokenów)">
      <bpmn:incoming>Flow_h_g1_h_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_h_t1_h_e1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_h_t1_ds_usage">
        <bpmn:targetRef>ds_usage</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="h_e1">
      <bpmn:incoming>Flow_h_t1_h_e1</bpmn:incoming>
      <bpmn:incoming>Flow_h_g1_h_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="h_g2" name="Kolejka Claude &lt; 6, planista ≥ 3 h temu, budżet OK?">
      <bpmn:incoming>Flow_h_split_h_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_h_g2_h_t2</bpmn:outgoing>
      <bpmn:outgoing>Flow_h_g2_h_e2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="h_t2" name="Dodaj zadanie planisty (Opus) do queue/">
      <bpmn:incoming>Flow_h_g2_h_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_h_t2_h_e2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_h_t2_ds_queue">
        <bpmn:targetRef>ds_queue</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="h_e2">
      <bpmn:incoming>Flow_h_t2_h_e2</bpmn:incoming>
      <bpmn:incoming>Flow_h_g2_h_e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="h_g3" name="Po 06:30 i brak podsumowania z dziś?">
      <bpmn:incoming>Flow_h_split_h_g3</bpmn:incoming>
      <bpmn:outgoing>Flow_h_g3_h_t3</bpmn:outgoing>
      <bpmn:outgoing>Flow_h_g3_h_e3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="h_t3" name="Dodaj zadanie podsumowania dnia (Sonnet)">
      <bpmn:incoming>Flow_h_g3_h_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_h_t3_h_e3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_h_t3_ds_queue">
        <bpmn:targetRef>ds_queue</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="h_e3">
      <bpmn:incoming>Flow_h_t3_h_e3</bpmn:incoming>
      <bpmn:incoming>Flow_h_g3_h_e3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_usage" name="usage.json (odczyt limitów)" dataStoreRef="DataStore_ds_usage" />
    <bpmn:dataStoreReference id="ds_queue" name="Kolejka queue/" dataStoreRef="DataStore_ds_queue" />
    <bpmn:startEvent id="pl_start" name="Zadanie planisty z kolejki">
      <bpmn:outgoing>Flow_pl_start_pl_read</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pl_read" name="Czytaj wyniki, runs.jsonl, otwarte PR-y, Now projektów">
      <bpmn:incoming>Flow_pl_start_pl_read</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_read_pl_ideas</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pl_ideas" name="Przejrzyj sekcję Pomysły w notatce">
      <bpmn:incoming>Flow_pl_read_pl_ideas</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_ideas_pl_gw</bpmn:outgoing>
      <bpmn:property id="Property_pl_ideas_ds_note" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ds_note_pl_ideas">
        <bpmn:sourceRef>ds_note</bpmn:sourceRef>
        <bpmn:targetRef>Property_pl_ideas_ds_note</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="pl_gw" name="Co z pomysłem?">
      <bpmn:incoming>Flow_pl_ideas_pl_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_gw_pl_task</bpmn:outgoing>
      <bpmn:outgoing>Flow_pl_gw_pl_q</bpmn:outgoing>
      <bpmn:outgoing>Flow_pl_gw_pl_gpu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="pl_task" name="Zadanie do queue/">
      <bpmn:incoming>Flow_pl_gw_pl_task</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_task_pl_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pl_q" name="Pytanie do „Czeka na Piotra”">
      <bpmn:incoming>Flow_pl_gw_pl_q</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_q_pl_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pl_gpu" name="Propozycja GPU w notatce (polecenie, czas)">
      <bpmn:incoming>Flow_pl_gw_pl_gpu</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_gpu_pl_join</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_pl_gpu_ds_note">
        <bpmn:targetRef>ds_note</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="pl_join">
      <bpmn:incoming>Flow_pl_task_pl_join</bpmn:incoming>
      <bpmn:incoming>Flow_pl_q_pl_join</bpmn:incoming>
      <bpmn:incoming>Flow_pl_gpu_pl_join</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_join_pl_plan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="pl_plan" name="Dopisz 6–10 zadań, wybierz model: local / haiku / sonnet / opus">
      <bpmn:incoming>Flow_pl_join_pl_plan</bpmn:incoming>
      <bpmn:outgoing>Flow_pl_plan_pl_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_pl_plan_ds_queue">
        <bpmn:targetRef>ds_queue</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="pl_end" name="Kolejka uzupełniona">
      <bpmn:incoming>Flow_pl_plan_pl_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_note" name="Notatka mac-praca-w-tle" dataStoreRef="DataStore_ds_note" />
    <bpmn:startEvent id="w_start" name="Co 20 s, każdy worker">
      <bpmn:outgoing>Flow_w_start_w_take</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_w_start">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT20S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="w_take" name="Weź najlepsze zadanie z queue/ (priorytet, after, lock)">
      <bpmn:incoming>Flow_w_start_w_take</bpmn:incoming>
      <bpmn:outgoing>Flow_w_take_w_model</bpmn:outgoing>
      <bpmn:property id="Property_w_take_ds_queue_w" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ds_queue_w_w_take">
        <bpmn:sourceRef>ds_queue_w</bpmn:sourceRef>
        <bpmn:targetRef>Property_w_take_ds_queue_w</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="w_model" name="Model lokalny (local:*)?">
      <bpmn:incoming>Flow_w_take_w_model</bpmn:incoming>
      <bpmn:outgoing>Flow_w_model_w_win</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_model_w_away</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="w_win" name="W oknie i zdąży przed jego końcem?">
      <bpmn:incoming>Flow_w_model_w_win</bpmn:incoming>
      <bpmn:outgoing>Flow_w_win_w_budget</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_win_w_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="w_budget" name="Tydzień &lt; 80% i &lt; linia tempa, sesja &lt; 90%?">
      <bpmn:incoming>Flow_w_win_w_budget</bpmn:incoming>
      <bpmn:outgoing>Flow_w_budget_w_claude</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_budget_w_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="w_claude" name="Claude Code na Claude: nowa sesja, rules.md, tryb auto">
      <bpmn:incoming>Flow_w_budget_w_claude</bpmn:incoming>
      <bpmn:outgoing>Flow_w_claude_w_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="w_wait" name="Zostaje w kolejce">
      <bpmn:incoming>Flow_w_win_w_wait</bpmn:incoming>
      <bpmn:incoming>Flow_w_budget_w_wait</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="w_away" name="Piotr nieobecny 10 min, zasilacz, chłodno, pamięć OK, &lt; 8 dziś?">
      <bpmn:incoming>Flow_w_model_w_away</bpmn:incoming>
      <bpmn:outgoing>Flow_w_away_w_borrow</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_away_w_wait2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="w_borrow" name="Utwórz gpu/borrow (GPU dla LLM)">
      <bpmn:incoming>Flow_w_away_w_borrow</bpmn:incoming>
      <bpmn:outgoing>Flow_w_borrow_w_local</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="w_local" name="Claude Code na Ollamie (qwen / gemma), bez limitu">
      <bpmn:incoming>Flow_w_borrow_w_local</bpmn:incoming>
      <bpmn:outgoing>Flow_w_local_w_merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="w_wait2" name="Czeka, aż Piotr odejdzie">
      <bpmn:incoming>Flow_w_away_w_wait2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="w_merge">
      <bpmn:incoming>Flow_w_claude_w_merge</bpmn:incoming>
      <bpmn:incoming>Flow_w_local_w_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_w_merge_w_result</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="w_result" name="Wynik?">
      <bpmn:incoming>Flow_w_merge_w_result</bpmn:incoming>
      <bpmn:outgoing>Flow_w_result_w_save</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_result_w_limitq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="w_save" name="Zapisz wynik, runs.jsonl, wiersz w raporcie; PR do dev">
      <bpmn:incoming>Flow_w_result_w_save</bpmn:incoming>
      <bpmn:outgoing>Flow_w_save_w_done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="w_done" name="done/">
      <bpmn:incoming>Flow_w_save_w_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="w_limitq" name="Komunikat o limicie (Claude)?">
