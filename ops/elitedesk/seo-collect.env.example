# seo-collect.env — config for ops/elitedesk/seo-collect.py
# Copy to seo-collect.env (gitignored), fill in, chmod 600.

# Same ingest endpoint + shared token every other agent on this host uses.
INGEST_URL=http://127.0.0.1:64421/api/ingest
INGEST_TOKEN=

# Google service-account key (JSON) for Search Console + GA4. Keep it next to
# this file, chmod 600, never commit it. The account's e-mail must be added as
# a (restricted) user on each GSC property and as Viewer on each GA4 property.
# Unset = GSC + GA4 are skipped with a warning.
SEO_SA_JSON=/home/piotr/code/logs-stack/ops/elitedesk/seo-sa.json

# Places API (New) key, restricted to "Places API (New)". Optional — unset =
# competitor review tracking is skipped with a warning.
PLACES_API_KEY=

# Optional overrides (defaults shown):
# GSC_DAYS=7
# GA4_DAYS=3
# SEO_CONFIG=/home/piotr/code/logs-stack/ops/elitedesk/seo-collect.sites.json
# HOST_NAME=elitedesk
