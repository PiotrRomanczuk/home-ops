    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_budget" sourceRef="Note_budget" targetRef="w_budget" />
    <bpmn:textAnnotation id="Note_local">
      <bpmn:text>Lokalny model: ANTHROPIC_BASE_URL → Ollama, jedno naraz, najwyżej 8 dziennie. Porażka → sonnet (już w oknach i budżecie).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_local" sourceRef="Note_local" targetRef="w_local" />
  </bpmn:process>
  <bpmn:process id="Process_GPU" isExecutable="false">
    <bpmn:startEvent id="g_start" name="Co 30 s">
      <bpmn:outgoing>Flow_g_start_g_collect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_g_start">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="g_collect" name="Zbierz zakończone shardy; gotowe zadanie → następne z listy">
      <bpmn:incoming>Flow_g_start_g_collect</bpmn:incoming>
      <bpmn:outgoing>Flow_g_collect_g_read</bpmn:outgoing>
      <bpmn:property id="Property_g_collect_ds_jobs" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ds_jobs_g_collect">
        <bpmn:sourceRef>ds_jobs</bpmn:sourceRef>
        <bpmn:targetRef>Property_g_collect_ds_jobs</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:serviceTask id="g_read" name="Odczyt Maca: bezczynność, zasilacz, thermalState, pamięć, ekran, Logic, borrow">
      <bpmn:incoming>Flow_g_collect_g_read</bpmn:incoming>
      <bpmn:outgoing>Flow_g_read_g_must</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_must" name="Bateria, thermalState ≥ 2 albo pamięć ≥ 2?">
      <bpmn:incoming>Flow_g_read_g_must</bpmn:incoming>
      <bpmn:outgoing>Flow_g_must_g_stop</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_must_g_hold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="g_stop" name="Zatrzymaj shardy: CONT + TERM, po 30 s KILL">
      <bpmn:incoming>Flow_g_must_g_stop</bpmn:incoming>
      <bpmn:outgoing>Flow_g_stop_g_stop_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="g_stop_end" name="Wznowią się później od miejsca przerwania">
      <bpmn:incoming>Flow_g_stop_g_stop_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_hold" name="Piotr przy Macu, borrow, obce song2logic albo dark wake?">
      <bpmn:incoming>Flow_g_must_g_hold</bpmn:incoming>
      <bpmn:outgoing>Flow_g_hold_g_pause</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_hold_g_resume</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="g_pause" name="Wstrzymaj shardy (SIGSTOP)">
      <bpmn:incoming>Flow_g_hold_g_pause</bpmn:incoming>
      <bpmn:outgoing>Flow_g_pause_g_pause_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="g_pause_end" name="Pauza bez strat">
      <bpmn:incoming>Flow_g_pause_g_pause_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="g_resume" name="Wznów wstrzymane (SIGCONT)">
      <bpmn:incoming>Flow_g_hold_g_resume</bpmn:incoming>
      <bpmn:outgoing>Flow_g_resume_g_can</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_can" name="Zasilacz, thermalState 0, pamięć w normie?">
      <bpmn:incoming>Flow_g_resume_g_can</bpmn:incoming>
      <bpmn:outgoing>Flow_g_can_g_run</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_can_g_wait_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="g_run" name="Uruchom brakujące shardy bieżącego zadania (grupy procesów)">
      <bpmn:incoming>Flow_g_can_g_run</bpmn:incoming>
      <bpmn:outgoing>Flow_g_run_g_run_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="g_run_end" name="Pracuje">
      <bpmn:incoming>Flow_g_run_g_run_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="g_wait_end" name="Czeka na warunki">
      <bpmn:incoming>Flow_g_can_g_wait_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_jobs" name="gpu-jobs.json (root)" dataStoreRef="DataStore_ds_jobs" />
    <bpmn:sequenceFlow id="Flow_g_start_g_collect" sourceRef="g_start" targetRef="g_collect" />
    <bpmn:sequenceFlow id="Flow_g_collect_g_read" sourceRef="g_collect" targetRef="g_read" />
    <bpmn:sequenceFlow id="Flow_g_read_g_must" sourceRef="g_read" targetRef="g_must" />
    <bpmn:sequenceFlow id="Flow_g_must_g_stop" name="tak" sourceRef="g_must" targetRef="g_stop" />
    <bpmn:sequenceFlow id="Flow_g_stop_g_stop_end" sourceRef="g_stop" targetRef="g_stop_end" />
    <bpmn:sequenceFlow id="Flow_g_must_g_hold" name="nie" sourceRef="g_must" targetRef="g_hold" />
    <bpmn:sequenceFlow id="Flow_g_hold_g_pause" name="tak" sourceRef="g_hold" targetRef="g_pause" />
    <bpmn:sequenceFlow id="Flow_g_pause_g_pause_end" sourceRef="g_pause" targetRef="g_pause_end" />
    <bpmn:sequenceFlow id="Flow_g_hold_g_resume" name="nie" sourceRef="g_hold" targetRef="g_resume" />
    <bpmn:sequenceFlow id="Flow_g_resume_g_can" sourceRef="g_resume" targetRef="g_can" />
    <bpmn:sequenceFlow id="Flow_g_can_g_run" name="tak" sourceRef="g_can" targetRef="g_run" />
    <bpmn:sequenceFlow id="Flow_g_run_g_run_end" sourceRef="g_run" targetRef="g_run_end" />
    <bpmn:sequenceFlow id="Flow_g_can_g_wait_end" name="nie" sourceRef="g_can" targetRef="g_wait_end" />
    <bpmn:textAnnotation id="Note_gpu">
      <bpmn:text>Kolejka GPU: song2logic Strummy → llm-bench gemma4:26b → llm-bench qwen3.8:27b → song2logic polubione. Pauza zamraża procesy, stop = przebieg wznowi się od miejsca przerwania (JSONL).</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
