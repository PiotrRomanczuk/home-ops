[Unit]
Description=home-ops pr-review — independent review of every open PR's head commit (second pair of eyes)
After=docker.service network-online.target
Wants=network-online.target
OnFailure=unit-failure-mail@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/code/logs-stack
EnvironmentFile=%h/code/logs-stack/ops/elitedesk/seo-collect.env
ExecStart=/usr/bin/python3 %h/code/logs-stack/ops/elitedesk/pr_review.py
# Up to 3 PRs × two claude -p passes.
TimeoutStartSec=90min
StandardOutput=journal
StandardError=journal
