[Unit]
Description=home-ops pr-decide — every open GitHub PR becomes a Decisions question
After=docker.service network-online.target
Wants=network-online.target
OnFailure=unit-failure-mail@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/code/logs-stack
EnvironmentFile=%h/code/logs-stack/ops/elitedesk/seo-collect.env
ExecStart=/usr/bin/python3 %h/code/logs-stack/ops/elitedesk/pr_decide.py
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
