<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- home-ops: the day as a card on Dziś, 21:30. If the Mac slept through it, launchd runs it
     at wake-up (the next morning) and day-summary.py then summarises yesterday (before 21:00 = yesterday).
     Installed by scripts/deploy-agent.sh mac day-summary (__HOME__ is replaced on install). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.pionat.home-ops.day-summary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/bin/home-ops/run.sh</string>
    <string>day-summary.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/home-ops/day-summary.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/home-ops/day-summary.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
