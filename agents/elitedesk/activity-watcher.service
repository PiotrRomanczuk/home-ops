[Unit]
Description=home-ops activity watcher (unit runs, GitHub Actions jobs, right-now snapshot)
After=network.target docker.service

[Service]
Type=simple
EnvironmentFile=%h/.config/elitedesk-watcher.env
ExecStart=/usr/bin/python3 %h/bin/activity-watcher.py
Restart=on-failure
RestartSec=30
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
