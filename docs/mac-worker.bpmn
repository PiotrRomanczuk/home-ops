      <bpmn:outgoing>Flow_w_limitq_w_usage</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_limitq_w_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="w_usage" name="Odczyt /usage">
      <bpmn:incoming>Flow_w_limitq_w_usage</bpmn:incoming>
      <bpmn:outgoing>Flow_w_usage_w_exh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="w_exh" name="Któryś limit ≥ 99%?">
      <bpmn:incoming>Flow_w_usage_w_exh</bpmn:incoming>
      <bpmn:outgoing>Flow_w_exh_w_pause</bpmn:outgoing>
      <bpmn:outgoing>Flow_w_exh_w_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="w_pause" name="Pauza agentów do resetu; zadanie wraca do queue/">
