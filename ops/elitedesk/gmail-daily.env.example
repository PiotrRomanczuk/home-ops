# gmail-daily.env — config for ops/elitedesk/gmail-daily.py
# Copy to gmail-daily.env (gitignored), fill in, chmod 600.

# Digest card (same endpoint + token as every other agent on this host).
INGEST_URL=http://127.0.0.1:64421/api/ingest
INGEST_TOKEN=

# Rules come from Postgres (gmail.rules_json, migration 025). Set a file path
# instead to run against a JSON rules file (the pre-Postgres layout).
GMAIL_RULES=db

# OAuth client + refresh token (0600), created on the Mac with `gmail_cleanup.py auth`
# and copied here. The GCP consent screen must be *In production*, otherwise the
# refresh token expires after 7 days.
# GMAIL_CONFIG_DIR=/home/piotr/.config/home-ops
# GMAIL_STATE_DIR=/home/piotr/.local/state/home-ops/gmail

# Postgres via the compose container (defaults shown).
# CONTAINER=home-ops-postgres-1
# DB=home_ops
# DB_USER=postgres
