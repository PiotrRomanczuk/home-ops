      <bpmn:incoming>Flow_w_exh_w_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_w_retry_w_rend</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="w_rend" name="Kolejna próba albo failed/">
