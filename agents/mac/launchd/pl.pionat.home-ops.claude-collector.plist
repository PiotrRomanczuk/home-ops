<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- home-ops: ships Claude Code sessions (transcripts) every 5 min.
     Installed by scripts/deploy-agent.sh mac claude-collector (__HOME__ is replaced on install). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pl.pionat.home-ops.claude-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/bin/home-ops/run.sh</string>
    <string>claude-collector.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/home-ops/claude-collector.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/home-ops/claude-collector.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
