# brief-pull.env — config for ops/elitedesk/brief-pull.py
# Copy to ~/.config/home-ops/brief-pull.env, chmod 600. Every line is optional.

# Clone of PiotrRomanczuk/daily-brief (created on first run).
BRIEF_REPO_DIR=/home/piotr/code/daily-brief
# Uses the read-only deploy key via the `github-daily-brief` alias in ~/.ssh/config
# (see ops/elitedesk/README.md → "Daily briefs").
BRIEF_REPO_URL=git@github-daily-brief:PiotrRomanczuk/daily-brief.git
# Last processed commit (delete the file to force a full re-send — harmless, upserts).
# BRIEF_STATE=/home/piotr/.local/state/home-ops/brief-pull.state
# First-run backfill window in days (rows older than 120 days are pruned anyway).
# BRIEF_MAX_DAYS=120

# Unset = borrowed from ~/.config/elitedesk-watcher.env (same pair every agent uses).
# INGEST_URL=http://127.0.0.1:64421/api/ingest
# INGEST_TOKEN=
