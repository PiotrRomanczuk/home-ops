# github-repo-sync.env — config for ops/elitedesk/github-repo-sync.py
# Copy to github-repo-sync.env (gitignored) and fill in.

# GitHub PAT with read access to your repos, including private ones
# (fine-grained token scoped to Contents: read-only + Metadata: read-only is
# enough — this script only reads repo/commit/contents/releases endpoints).
# Optional since 2026-11-08: when unset, the script uses `gh auth token`
# (gh is logged in on elitedesk). This whole file is optional; INGEST_* come
# from ~/.config/elitedesk-watcher.env.
GITHUB_TOKEN=

# Same ingest endpoint + shared token every other agent on this host uses
# (see agents/elitedesk/planner-sync.py's env for the same pair).
INGEST_URL=http://127.0.0.1:64421/api/ingest
INGEST_TOKEN=

# Optional overrides (defaults shown):
# HOST_NAME=elitedesk
# PROJECTS_JSON=/home/<user>/logs-stack/ops/elitedesk/github-repo-sync.projects.json
